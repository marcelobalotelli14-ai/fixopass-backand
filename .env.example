DATABASE_URL="postgresql://fixopass:fixopass@localhost:5432/fixopass?schema=public"
PORT=3000
JWT_SECRET="troque-por-um-segredo-forte-em-producao"

# Upload da logo da empresa (POST /companies/me/logo)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Envio REAL de e-mail (src/lib/email.ts) — hoje só usado por
# POST /companies/forgot-password. Configure UM dos dois provedores abaixo
# (se os dois estiverem presentes, RESEND_API_KEY tem prioridade). Sem
# nenhum configurado, a rota recusa com 503 (fail closed) em vez de fingir
# que enviou — antes disso, o "envio" só aparecia no log do servidor.

# Opção 1 — Resend (https://resend.com/api-keys). Mais simples: só a API key.
RESEND_API_KEY=""

# Opção 2 — SMTP genérico via Nodemailer (Gmail, Amazon SES, Mailgun, etc.).
# SMTP_PORT=465 usa TLS implícito; qualquer outra porta (587, 25) usa STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Nome/e-mail do remetente mostrado nos e-mails enviados (RFC 5322 "From").
# Precisa ser um remetente autorizado no provedor escolhido (domínio
# verificado no Resend, ou a própria caixa autenticada no SMTP).
EMAIL_FROM="FIXO PASS <nao-responda@fixopass.com>"

# Usado para montar o link enviado em POST /companies/forgot-password e a
# authorizationUrl devolvida por POST /oauth/authorize
# (canal WEB/API) — precisa ser o domínio onde app/authorize.html está publicado.
PANEL_URL="https://painel.fixopass.com"

# Painel Super Admin (GET/PUT/DELETE /admin/*) — segredo compartilhado enviado
# no header X-ADMIN-SECRET. Sem isso configurado, as rotas admin recusam tudo
# com 503 (fail closed) em vez de ficar abertas. Gere um valor forte e único
# (ex.: `openssl rand -hex 32`) — nunca reaproveite um valor de exemplo.
ADMIN_SECRET=""

# Limpeza de dados FAKE/TESTE (GET/DELETE /admin/dados-teste, npm run
# limpar:teste) — protege esta conta específica da exclusão mesmo que o
# nome/e-mail dela bata na heurística de "parece teste". Preencha com os
# dados REAIS da conta que deve sobreviver à limpeza antes de rodar em
# produção. Nenhum dos dois é obrigatório (deixe vazio se não quiser essa
# proteção extra além da heurística).
ADMIN_MASTER_EMAIL=""
ADMIN_MASTER_CPF=""

# Mesma limpeza acima — a empresa "Pizzaria Balotelli" já é protegida
# incondicionalmente pelo nome (ver EMPRESA_PROTEGIDA_NOME em
# src/lib/limpezaDados.ts), sem precisar de nenhuma env var. Estas aqui são
# reforços OPCIONAIS: CNPJ/e-mail da empresa (mais preciso que o nome) e
# CPF/e-mail do usuário dono dela, caso seja uma pessoa diferente do Admin
# Master acima.
EMPRESA_PROTEGIDA_CNPJ=""
EMPRESA_PROTEGIDA_EMAIL=""
USUARIO_PROTEGIDO_CPF=""
USUARIO_PROTEGIDO_EMAIL=""

# POST /webhooks/payment — segredo compartilhado enviado no header
# X-WEBHOOK-SECRET pelo gateway de pagamento (ou por quem estiver simulando
# a notificação, enquanto não há integração real). Mesma lógica de fail
# closed: sem isso configurado, a rota recusa tudo com 503.
# IMPORTANTE: isso NÃO substitui a verificação de assinatura oficial do
# Mercado Pago/Asaas — é só a proteção mínima até uma integração de verdade
# entrar (ver comentário em src/routes/webhooks.ts).
PAYMENT_WEBHOOK_SECRET=""

# Integração REAL com o Mercado Pago — mantida no código (src/lib/mercadopago.ts,
# POST /webhooks/mercadopago) como alternativa, mas a rota de geração de PIX
# (POST /companies/me/pix) hoje usa o Asaas (ver ASAAS_API_KEY abaixo). Só
# preencha isso se for reativar o Mercado Pago como gateway.
MERCADOPAGO_ACCESS_TOKEN=""

# Integração REAL com a API v3 do Asaas (POST /companies/me/pix gera a
# cobrança PIX; POST /webhooks/asaas confirma o pagamento e ativa a
# empresa) — pegue em https://www.asaas.com/ > Integrações > API > "Gerar
# nova chave de API" (produção). Sem isso configurado, as duas rotas recusam
# com 503 (fail closed) em vez de fingir gerar um QR Code que ninguém
# conseguiria pagar de verdade.
ASAAS_API_KEY=""

# Opcional — aponta pro ambiente sandbox do Asaas durante testes
# (https://sandbox.asaas.com/api/v3) em vez da produção. Deixe vazio em
# produção (usa https://api.asaas.com/v3 por padrão).
ASAAS_API_URL=""

# POST /webhooks/asaas — token enviado pelo Asaas de volta no header
# `asaas-access-token`, configurado em Integrações > Webhooks no painel do
# Asaas ("Token de autenticação" do webhook). Sem isso configurado, a rota
# recusa tudo com 503 (fail closed). Gere um valor forte e único (ex.:
# `openssl rand -hex 32`) e cole o MESMO valor nos dois lugares (aqui e no
# painel do Asaas).
ASAAS_WEBHOOK_TOKEN=""
