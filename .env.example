DATABASE_URL="postgresql://fixopass:fixopass@localhost:5432/fixopass?schema=public"
PORT=3000
JWT_SECRET="troque-por-um-segredo-forte-em-producao"

# Upload da logo da empresa (POST /companies/me/logo)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Usado para montar o link enviado em POST /companies/forgot-password e a
# authorizationUrl devolvida por POST /integrations/authorization-requests
# (canal WEB/API) — precisa ser o domínio onde app/authorize.html está publicado.
PANEL_URL="https://painel.fixopass.com"

# Painel Super Admin (GET/PUT/DELETE /admin/*) — segredo compartilhado enviado
# no header X-ADMIN-SECRET. Sem isso configurado, as rotas admin recusam tudo
# com 503 (fail closed) em vez de ficar abertas. Gere um valor forte e único
# (ex.: `openssl rand -hex 32`) — nunca reaproveite um valor de exemplo.
ADMIN_SECRET=""

# POST /webhooks/payment — segredo compartilhado enviado no header
# X-WEBHOOK-SECRET pelo gateway de pagamento (ou por quem estiver simulando
# a notificação, enquanto não há integração real). Mesma lógica de fail
# closed: sem isso configurado, a rota recusa tudo com 503.
# IMPORTANTE: isso NÃO substitui a verificação de assinatura oficial do
# Mercado Pago/Asaas — é só a proteção mínima até uma integração de verdade
# entrar (ver comentário em src/routes/webhooks.ts).
PAYMENT_WEBHOOK_SECRET=""

# Integração REAL com o Mercado Pago (POST /companies/me/pix gera a cobrança
# PIX; POST /webhooks/mercadopago confirma o pagamento) — pegue em
# https://www.mercadopago.com.br/developers/panel > Suas integrações > sua
# aplicação > Credenciais de produção > "Access Token". Sem isso configurado,
# as duas rotas recusam com 503 (fail closed) em vez de fingir gerar um QR
# Code que ninguém conseguiria pagar de verdade. Depois de configurar,
# cadastre a URL pública de POST /webhooks/mercadopago como notification_url
# da aplicação no painel do Mercado Pago (ou deixe sem, e configure via IPN —
# ver comentário em src/routes/webhooks.ts).
MERCADOPAGO_ACCESS_TOKEN=""
