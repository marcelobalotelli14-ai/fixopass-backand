// FIXO PASS — Schema do banco de dados (Fase 1)
// Rodar: npx prisma migrate dev --name init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampoDado {
  NOME
  TELEFONE
  EMAIL
  CPF
  RG
  DATA_NASCIMENTO
  ENDERECO
  FOTO
}

enum CategoriaEmpresa {
  RESTAURANTE
  CONDOMINIO
  HOSPITAL
  HOTEL
  LOJA
  OUTROS
}

// Mesmos valores de CategoriaEmpresa + GERAL (regra "padrão" usada quando o
// usuário não configurou nada específico pra categoria da empresa que está
// pedindo acesso). É um enum separado — CategoriaEmpresa continua só com
// categorias de empresa de verdade, sem GERAL poluindo o cadastro de empresa.
enum CategoriaPrivacidade {
  RESTAURANTE
  CONDOMINIO
  HOSPITAL
  HOTEL
  LOJA
  OUTROS
  GERAL
}

// Status de assinatura/pagamento da empresa (diferente de `ativa`, que é
// "a empresa encerrou a própria conta" — ver comentário em Company).
enum StatusAssinatura {
  TRIAL
  ACTIVE
  EXPIRED
  BLOCKED
}

enum StatusSolicitacao {
  PENDENTE
  APROVADA
  NEGADA
  EXPIRADA
}

enum MetodoIdentificacao {
  NFC
  QRCODE
  CONSULTA_API
  WEB_API
}

// Status de uma Integração (client_id/client_secret do canal Web/API).
// Separado de "ativa"/"ativo" (usado em Company/Autorizacao) porque aqui o
// nome precisa deixar claro, no próprio painel, que revogar uma integração
// derruba imediatamente qualquer authorization_code pendente para ela — não
// é um soft-delete de cadastro, é "essa credencial parou de funcionar".
enum StatusIntegracao {
  ATIVA
  REVOGADA
}

// -----------------------------
// USUÁRIO (dono dos dados)
// -----------------------------
model User {
  id                  String    @id @default(uuid())
  nomeCompleto        String
  telefone            String
  email               String    @unique
  cpf                 String    @unique
  rg                  String?
  dataNascimento      DateTime?
  // `endereco` continua sendo o endereço em texto livre — é o que o
  // mobile-app (CadastroScreen.tsx) já envia e o que POST /users sempre
  // aceitou, então não pode ser removido/renomeado sem quebrar esse cliente.
  // Os campos abaixo são NOVOS e opcionais: quando o usuário preenche o
  // endereço estruturado pela web (Meus dados), eles ficam disponíveis além
  // do texto livre — não o substituem.
  endereco            String?
  enderecoCep         String?
  enderecoLogradouro  String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoEstado      String?
  fotoUrl             String?
  expoPushToken       String?
  senhaHash           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  autorizacoes         Autorizacao[]
  solicitacoes         SolicitacaoCompartilhamento[]
  logsAcesso           LogAcesso[]
  privacidadeCategoria PrivacidadeCategoria[]

  @@map("users")
}

// -----------------------------
// PRIVACIDADE POR CATEGORIA (o que o usuário libera, por padrão, pra cada
// TIPO de estabelecimento — ex.: libera Foto+Nome+Telefone pra restaurante,
// mas não CPF/RG/Endereço). Aplicada em POST /auth/request: filtra
// camposPedidos pelos campos liberados na categoria da empresa solicitante
// (ou em GERAL, se não houver regra específica pra aquela categoria) antes
// de a pessoa nem chegar a ver a tela de aprovação — não é uma segunda
// camada por cima do consentimento pontual, é um filtro que roda ANTES dele.
// -----------------------------
model PrivacidadeCategoria {
  id             String               @id @default(uuid())
  userId         String
  categoria      CategoriaPrivacidade
  foto           Boolean              @default(false)
  nome           Boolean              @default(true)
  cpf            Boolean              @default(false)
  rg             Boolean              @default(false)
  dataNascimento Boolean              @default(false)
  telefone       Boolean              @default(false)
  endereco       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoria])
  @@map("privacidade_categorias")
}

// -----------------------------
// EMPRESA
// -----------------------------
model Company {
  id                          String           @id @default(uuid())
  nome                        String
  cnpj                        String           @unique
  categoria                   CategoriaEmpresa
  emailContato                String           @unique
  senhaHash                   String
  apiKeyHash                  String           @unique
  webhookUrl                  String?
  logoUrl                     String?
  resetPasswordTokenHash      String?          @unique
  resetPasswordExpiresAt      DateTime?
  // Encerramento de conta (DELETE /companies/me) é SOFT DELETE — ao contrário do
  // usuário comum (que tem exclusão definitiva/LGPD via DELETE /users/me), a
  // empresa é só marcada como inativa. Isso preserva os logs de auditoria
  // (LogAcesso) e o histórico de autorizações/solicitações ligados a ela, que
  // continuam existindo no banco mesmo depois do encerramento.
  ativa                       Boolean          @default(true)
  encerradaEm                 DateTime?
  // Assinatura/pagamento — dimensão INDEPENDENTE de `ativa` (aquilo é "a
  // empresa fechou a própria conta"; isto é "a mensalidade está em dia").
  // Ver src/lib/assinatura.ts pra transição automática TRIAL->EXPIRED e
  // ACTIVE->EXPIRED, e POST /auth/request pra onde isso bloqueia pareamento.
  status                      StatusAssinatura @default(TRIAL)
  trialEndsAt                 DateTime?
  nextDueDate                 DateTime?
  precoMensalCentavos         Int?
  // Id do último pagamento do Mercado Pago já aplicado (soma de +30 dias já
  // feita) — guarda contra processar o mesmo pagamento duas vezes, já que o
  // Mercado Pago pode reenviar a mesma notificação de webhook mais de uma
  // vez (comportamento documentado deles, não é bug). Ver POST
  // /webhooks/mercadopago.
  ultimoPagamentoIdProcessado String?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  unidades          Unidade[]
  camposSolicitados CampoSolicitadoEmpresa[]
  autorizacoes      Autorizacao[]
  solicitacoes      SolicitacaoCompartilhamento[]
  logsAcesso        LogAcesso[]
  integracoes       Integracao[]

  @@map("companies")
}

// -----------------------------
// INTEGRAÇÃO (canal WEB/API — credenciais de um sistema externo, ex.: o
// cardápio online da empresa). Uma empresa pode ter mais de uma integração
// (cardápio, ERP, etc.), cada uma com seu próprio client_id/client_secret e
// redirect URIs cadastradas — propositalmente separado da apiKeyHash usada
// pelo ERP (companyAuth): a API Key do ERP roda 100% server-to-server e
// nunca sai do servidor da empresa; um client_secret de integração também
// nunca deve ir para o navegador, mas o client_id É exposto no fluxo (é o
// "usuário" do Basic Auth em POST /integrations/*), então tratá-los como a
// mesma credencial obrigaria a girar a API Key inteira do ERP só porque um
// site de terceiro precisou de uma credencial nova.
// -----------------------------
model Integracao {
  id               String           @id @default(uuid())
  companyId        String
  nome             String
  clientId         String           @unique @default(uuid())
  clientSecretHash String
  redirectUris     String[]
  status           StatusIntegracao @default(ATIVA)
  createdAt        DateTime         @default(now())
  revogadaEm       DateTime?

  company      Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  solicitacoes SolicitacaoCompartilhamento[]
  codigos      AutorizacaoCodigo[]

  @@index([companyId])
  @@map("integracoes")
}

// Unidades da empresa (ex: filiais)
model Unidade {
  id          String   @id @default(uuid())
  companyId   String
  nome        String
  endereco    String?
  qrCodeToken String   @unique @default(uuid())
  createdAt   DateTime @default(now())

  company      Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  solicitacoes SolicitacaoCompartilhamento[]

  @@map("unidades")
}

// Quais campos cada empresa solicita por padrão (config do painel da empresa)
model CampoSolicitadoEmpresa {
  id          String    @id @default(uuid())
  companyId   String
  campo       CampoDado
  obrigatorio Boolean   @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, campo])
  @@map("campos_solicitados_empresa")
}

// -----------------------------
// AUTORIZAÇÃO (usuário -> empresa, campos liberados permanentemente)
// -----------------------------
model Autorizacao {
  id              String      @id @default(uuid())
  userId          String
  companyId       String
  camposLiberados CampoDado[]
  ativo           Boolean     @default(true)
  dataAutorizacao DateTime    @default(now())
  dataRevogacao   DateTime?
  // Contador de pareamentos: incrementado a cada POST /customer/share
  // aprovado (usuário lendo o QR/NFC dessa empresa de novo), não em
  // GET /customer/:id (isso é consulta direta do ERP, não um evento de
  // NFC/QR de verdade — mesmo critério que já separa os métodos em
  // LogAcesso). accessCount começa em 1 (a própria criação já é o
  // primeiro pareamento) e lastAccessedAt acompanha.
  accessCount     Int         @default(1)
  lastAccessedAt  DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("autorizacoes")
}

// -----------------------------
// SOLICITAÇÃO DE COMPARTILHAMENTO (evento pontual via NFC/QR/WEB_API)
// -----------------------------
model SolicitacaoCompartilhamento {
  id            String              @id @default(uuid())
  // Opcional: NFC/QR e o fluxo iniciado pelo ERP sempre sabem o usuário na
  // hora de criar a solicitação (é quem escaneou, ou quem foi identificado
  // por CPF/telefone). O canal WEB/API é o único caso em que a solicitação
  // nasce ANTES de sabermos o usuário — o cardápio cria a solicitação, e só
  // quando a pessoa loga no FIXO PASS pra ver a tela de consentimento
  // (GET /integrations/authorize/:id) é que userId é preenchido. Depois de
  // preenchido, nunca mais muda.
  userId        String?
  companyId     String
  unidadeId     String?
  // Preenchidos apenas para metodo = WEB_API — de qual integração veio o
  // pedido e para qual redirect URI o navegador deve voltar depois de
  // autorizar. NFC/QR nunca preenchem isso (a "volta" deles é o próprio
  // app, não um redirect HTTP).
  integracaoId  String?
  redirectUri   String?
  // Finalidade em texto livre, mostrada na tela de consentimento
  // (ex.: "Preenchimento dos dados de entrega"). Opcional — NFC/QR não usam.
  purpose       String?
  metodo        MetodoIdentificacao
  camposPedidos CampoDado[]
  status        StatusSolicitacao   @default(PENDENTE)
  // Validade da PRÓPRIA solicitação (o usuário precisa aprovar/negar antes
  // disso) — só setado para WEB_API. NFC/QR resolvem na hora (o app já está
  // com a pessoa em mãos), então nunca precisaram de expiração própria.
  // Checado sob demanda (mesmo padrão de verificarAssinatura em
  // lib/assinatura.ts), sem cron/scheduler novo.
  expiraEm      DateTime?
  criadaEm      DateTime            @default(now())
  resolvidaEm   DateTime?

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unidade           Unidade?           @relation(fields: [unidadeId], references: [id])
  integracao        Integracao?        @relation(fields: [integracaoId], references: [id], onDelete: Cascade)
  autorizacaoCodigo AutorizacaoCodigo?

  @@map("solicitacoes_compartilhamento")
}

// -----------------------------
// AUTHORIZATION CODE (canal WEB/API) — o "authorization_code" temporário
// entregue ao navegador depois que o usuário aprova em
// POST /integrations/authorize/:requestId, e trocado pelo BACKEND do
// sistema externo (nunca pelo navegador) em POST /integrations/token.
//
// Guardamos só o HASH (sha256) do código, indexado — o mesmo padrão já
// usado para resetPasswordTokenHash em Company (ver companies.ts), e
// deliberadamente diferente do bcrypt "comparar contra todas as linhas"
// usado em companyAuth/identifyActor: ali há poucas empresas ativas, aqui
// os códigos se acumulam (um por tentativa de autorização) e o lookup
// precisa continuar O(1) mesmo depois de meses em produção.
//
// usadoEm marca consumo (proteção contra replay); a troca em POST
// /integrations/token usa um update condicional (WHERE usadoEm IS NULL)
// para o "uso único" valer mesmo sob duas requisições concorrentes.
// -----------------------------
model AutorizacaoCodigo {
  id              String      @id @default(uuid())
  codigoHash      String      @unique
  solicitacaoId   String      @unique
  integracaoId    String
  companyId       String
  userId          String
  camposLiberados CampoDado[]
  redirectUri     String
  expiraEm        DateTime
  usadoEm         DateTime?
  createdAt       DateTime    @default(now())

  solicitacao SolicitacaoCompartilhamento @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  integracao  Integracao                  @relation(fields: [integracaoId], references: [id], onDelete: Cascade)

  @@index([integracaoId])
  @@map("autorizacao_codigos")
}

// -----------------------------
// LOG DE ACESSO (histórico/auditoria — obrigatório por segurança)
// -----------------------------
model LogAcesso {
  id             String              @id @default(uuid())
  userId         String
  companyId      String
  camposEnviados CampoDado[]
  metodo         MetodoIdentificacao
  ipOrigem       String?
  timestamp      DateTime            @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("logs_acesso")
}
