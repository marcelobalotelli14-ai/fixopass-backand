// FIXO PASS — Schema do banco de dados (Fase 1)
// Rodar: npx prisma migrate dev --name init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Como o cadastro do usuário chegou ao sistema — usado pelo admin-dashboard
// pra segmentar novos usuários por canal de aquisição (GET /admin/users-stats).
// LINK_WEB é o fluxo de 1 clique app/authorize.html -> app/register-user.html
// (repositório fixopass-painel-web); os demais pontos de entrada continuam
// gravando MANUAL até serem instrumentados.
enum OrigemCadastro {
  QRCODE
  NFC
  LINK_WEB
  MANUAL
}

enum CampoDado {
  NOME
  TELEFONE
  EMAIL
  CPF
  RG
  DATA_NASCIMENTO
  ENDERECO
  FOTO
}

enum CategoriaEmpresa {
  RESTAURANTE
  CONDOMINIO
  HOSPITAL
  HOTEL
  LOJA
  OUTROS
}

// Mesmos valores de CategoriaEmpresa + GERAL (regra "padrão" usada quando o
// usuário não configurou nada específico pra categoria da empresa que está
// pedindo acesso). É um enum separado — CategoriaEmpresa continua só com
// categorias de empresa de verdade, sem GERAL poluindo o cadastro de empresa.
enum CategoriaPrivacidade {
  RESTAURANTE
  CONDOMINIO
  HOSPITAL
  HOTEL
  LOJA
  OUTROS
  GERAL
}

// Status de assinatura/pagamento da empresa (diferente de `ativa`, que é
// "a empresa encerrou a própria conta" — ver comentário em Company).
enum StatusAssinatura {
  TRIAL
  ACTIVE
  EXPIRED
  BLOCKED
}

enum StatusSolicitacao {
  PENDENTE
  APROVADA
  NEGADA
  EXPIRADA
}

enum MetodoIdentificacao {
  NFC
  QRCODE
  CONSULTA_API
  WEB_API
}

// Status de um OAuthClient (client_id/client_secret do canal Web/API,
// autenticação OAuth2). Separado de "ativa"/"ativo" (usado em
// Company/Autorizacao) porque aqui o nome precisa deixar claro, no próprio
// painel, que revogar um client derruba imediatamente qualquer code/token
// pendente para ele — não é um soft-delete de cadastro, é "essa credencial
// parou de funcionar".
enum OAuthClientStatus {
  ACTIVE
  REVOKED
}

// -----------------------------
// USUÁRIO (dono dos dados)
// -----------------------------
model User {
  id                   String    @id @default(uuid())
  nomeCompleto         String
  telefone             String
  email                String    @unique
  cpf                  String    @unique
  rg                   String?
  dataNascimento       DateTime?
  endereco             String?
  enderecoCep          String?
  enderecoLogradouro   String?
  enderecoNumero       String?
  enderecoComplemento  String?
  enderecoBairro       String?
  enderecoCidade       String?
  enderecoEstado       String?
  fotoUrl              String?
  expoPushToken        String?
  senhaHash            String
  // Canal pelo qual o cadastro chegou — ver comentário no enum OrigemCadastro.
  origem               OrigemCadastro @default(MANUAL)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  autorizacoes         Autorizacao[]
  solicitacoes         SolicitacaoCompartilhamento[]
  logsAcesso           LogAcesso[]
  privacidadeCategoria PrivacidadeCategoria[]

  @@map("users")
}

model PrivacidadeCategoria {
  id             String   @id @default(uuid())
  userId         String
  categoria      CategoriaPrivacidade
  foto           Boolean  @default(false)
  nome           Boolean  @default(true)
  cpf            Boolean  @default(false)
  rg             Boolean  @default(false)
  dataNascimento Boolean  @default(false)
  telefone       Boolean  @default(false)
  endereco       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoria])
  @@map("privacidade_categorias")
}

model Company {
  id                          String           @id @default(uuid())
  nome                        String
  cnpj                        String           @unique
  categoria                   CategoriaEmpresa
  emailContato                String           @unique
  senhaHash                   String
  apiKeyHash                  String           @unique
  webhookUrl                  String?
  logoUrl                     String?
  resetPasswordTokenHash      String?          @unique
  resetPasswordExpiresAt      DateTime?
  ativa                       Boolean          @default(true)
  encerradaEm                 DateTime?
  status                      StatusAssinatura @default(TRIAL)
  trialEndsAt                 DateTime?
  nextDueDate                 DateTime?
  precoMensalCentavos         Int?
  ultimoPagamentoIdProcessado String?
  // Marca empresas de teste/demonstração — usada pelo admin-dashboard pra
  // excluir esses registros das métricas por padrão. Ver GET /admin/dashboard-stats.
  isTest                      Boolean          @default(false)
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  unidades          Unidade[]
  camposSolicitados CampoSolicitadoEmpresa[]
  autorizacoes      Autorizacao[]
  solicitacoes      SolicitacaoCompartilhamento[]
  logsAcesso        LogAcesso[]
  oauthClients      OAuthClient[]

  @@map("companies")
}

model OAuthClient {
  id               String            @id @default(uuid())
  companyId        String
  name             String
  clientId         String            @unique @default(uuid())
  clientSecretHash String
  redirectUris     String[]
  status           OAuthClientStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  revokedAt        DateTime?

  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  solicitacoes SolicitacaoCompartilhamento[]
  codes        OAuthCode[]
  tokens       OAuthToken[]

  @@index([companyId])
  @@map("oauth_clients")
}

model Unidade {
  id          String   @id @default(uuid())
  companyId   String
  nome        String
  endereco    String?
  qrCodeToken String   @unique @default(uuid())
  createdAt   DateTime @default(now())

  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  solicitacoes SolicitacaoCompartilhamento[]

  @@map("unidades")
}

model CampoSolicitadoEmpresa {
  id          String    @id @default(uuid())
  companyId   String
  campo       CampoDado
  obrigatorio Boolean   @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, campo])
  @@map("campos_solicitados_empresa")
}

model Autorizacao {
  id              String      @id @default(uuid())
  userId          String
  companyId       String
  camposLiberados CampoDado[]
  ativo           Boolean     @default(true)
  dataAutorizacao DateTime    @default(now())
  dataRevogacao   DateTime?
  accessCount     Int         @default(1)
  lastAccessedAt  DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("autorizacoes")
}

model SolicitacaoCompartilhamento {
  id String @id @default(uuid())
  userId String?
  companyId String
  unidadeId String?
  integracaoId String?
  redirectUri String?
  purpose String?
  state String?
  metodo MetodoIdentificacao
  camposPedidos CampoDado[]
  status StatusSolicitacao @default(PENDENTE)
  expiraEm DateTime?
  criadaEm DateTime @default(now())
  resolvidaEm DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unidade Unidade? @relation(fields: [unidadeId], references: [id])
  integracao OAuthClient? @relation(fields: [integracaoId], references: [id], onDelete: Cascade)
  oauthCode OAuthCode?

  @@map("solicitacoes_compartilhamento")
}

model OAuthCode {
  id            String    @id @default(uuid())
  codeHash      String    @unique
  requestId     String    @unique
  oauthClientId String
  companyId     String
  userId        String
  scopes        CampoDado[]
  redirectUri   String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  request     SolicitacaoCompartilhamento @relation(fields: [requestId], references: [id], onDelete: Cascade)
  oauthClient OAuthClient                 @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  token       OAuthToken?

  @@index([oauthClientId])
  @@map("oauth_codes")
}

model OAuthToken {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  oauthClientId String
  oauthCodeId   String    @unique
  companyId     String
  userId        String
  scopes        CampoDado[]
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  oauthClient OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  oauthCode   OAuthCode   @relation(fields: [oauthCodeId], references: [id], onDelete: Cascade)

  @@index([oauthClientId])
  @@map("oauth_tokens")
}

model LogAcesso {
  id             String   @id @default(uuid())
  userId         String
  companyId      String
  camposEnviados CampoDado[]
  metodo         MetodoIdentificacao
  ipOrigem       String?
  timestamp      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("logs_acesso")
}
